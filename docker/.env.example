# Copy to `.env` (never commit it) and replace every value.

# Public DNS name of this server; Caddy obtains a Let's Encrypt certificate for it.
# Ports 80 and 443 must be reachable from the internet for the ACME challenge.
PROMETHEUS_PUBLIC_HOST=metrics.campus.example.edu
ACME_EMAIL=netops@campus.example.edu

# Shared secret the Vercel app presents to Caddy. Generate with: openssl rand -hex 32
PROMETHEUS_BEARER_TOKEN=change-me

# Grafana admin login (Grafana listens on 127.0.0.1:3000 only).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

# SNMPv2c read-only community used by snmp-exporter.
SNMP_COMMUNITY=change-me

PROMETHEUS_RETENTION=30d
PROMETHEUS_EXTERNAL_URL=http://localhost:9090
VECTOR_LOG=info

# Only for `docker compose --profile kea up -d`
KEA_CONTROL_AGENT_URLS=http://kea.campus.example.edu:8000

# ---------------------------------------------------------------------------
# Notifications: email, SMS and WhatsApp.
# A channel is switched on only when ALL of its settings are filled in.
# Check with:  docker compose run --rm notifier python notifier.py --check-config
# Send a test: docker compose run --rm notifier python notifier.py --test
# ---------------------------------------------------------------------------
NOTIFY_NAME=eaziguard
# Link added to emails and WhatsApp messages.
DASHBOARD_URL=https://eaziguard.khaw.cc

# --- Email (any SMTP service: Google Workspace, Microsoft 365, SES, SendGrid ...)
# SMTP_SECURITY is starttls (port 587), ssl (port 465) or none (port 25, trusted relay only).
SMTP_HOST=
SMTP_PORT=
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@campus.example.edu
# Comma-separated recipients.
EMAIL_TO=

# --- SMS and WhatsApp through Twilio (console.twilio.com)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# SMS sender: a Twilio number in E.164 format, or a Messaging Service SID instead.
SMS_FROM=
TWILIO_MESSAGING_SERVICE_SID=
# Comma-separated recipients in E.164 format, for example +14155550123
SMS_TO=
# WhatsApp sender: your approved WhatsApp number, or the Twilio sandbox number +14155238886.
WHATSAPP_FROM=
WHATSAPP_TO=
# Needed to message people who have not written to you in the last 24 hours:
# the Content SID (HX...) of a WhatsApp template with one variable, {{1}}.
TWILIO_WHATSAPP_CONTENT_SID=

# --- Who gets what
# Lowest severity each channel receives: info, warning or critical.
NOTIFY_EMAIL_MIN_SEVERITY=warning
NOTIFY_SMS_MIN_SEVERITY=critical
NOTIFY_WHATSAPP_MIN_SEVERITY=critical
# Channels that also get "resolved" messages (comma-separated; empty means none).
NOTIFY_RESOLVED=email
# Safety cap on messages per channel per hour (each recipient counts as one).
NOTIFY_SMS_MAX_PER_HOUR=20
NOTIFY_WHATSAPP_MAX_PER_HOUR=20
