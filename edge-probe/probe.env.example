# Copy to /etc/campus-edge-probe/probe.env (mode 0640) and edit.
# systemd EnvironmentFile format: KEY=value, one per line, comments on their own lines only.

# --- identity -------------------------------------------------------------------
# Label for this probe's location: dorm-a, library, lecture-hall-1 ...
PROBE_ZONE=library
# NIC in the client VLAN the probe represents.
PROBE_INTERFACE=eth0

# --- scheduling / exporter --------------------------------------------------------
PROBE_INTERVAL_SECONDS=30
METRICS_BIND_ADDRESS=0.0.0.0
METRICS_PORT=8000

# --- DHCP -----------------------------------------------------------------------
DHCP_ENABLED=true
# discover = DISCOVER -> OFFER only (uses the NIC's own MAC, takes no lease)
# full     = also REQUEST -> ACK, then RELEASE (uses a derived MAC; DHCP snooping
#            with MAC verification may drop it)
DHCP_MODE=discover
DHCP_TIMEOUT_SECONDS=5

# --- DNS ------------------------------------------------------------------------
DNS_ENABLED=true
# Comma-separated resolver IPs. Leave empty to use /etc/resolv.conf, i.e. what
# clients on this VLAN receive from DHCP.
DNS_RESOLVERS=10.0.0.53,10.0.0.54
DNS_DOMAINS=portal.campus.example.edu,www.wikipedia.org
DNS_TIMEOUT_SECONDS=3

# --- captive portal -----------------------------------------------------------------
PORTAL_ENABLED=true
# Plain-HTTP URL an unauthenticated client requests. A healthy portal answers with a redirect.
PORTAL_CHECK_URL=http://connectivitycheck.gstatic.com/generate_204
# Optional: host name the redirect must point at (empty accepts any redirect).
PORTAL_EXPECTED_HOST=portal.campus.example.edu
PORTAL_TIMEOUT_SECONDS=8
PORTAL_VERIFY_TLS=true

# --- RADIUS (optional; drives the RADIUSAuthLatency alert) ---------------------------
RADIUS_ENABLED=false
RADIUS_SERVERS=10.0.0.112,10.0.0.113
RADIUS_PORT=1812
# The probe host must be defined as a RADIUS client on the server with this secret.
RADIUS_SECRET=
RADIUS_TEST_USERNAME=eaziguard-probe
RADIUS_TEST_PASSWORD=not-a-real-password
RADIUS_TIMEOUT_SECONDS=3

# --- advanced (normally left alone) ---------------------------------------------------
# Pin DHCP traffic to PROBE_INTERFACE (needs CAP_NET_RAW, granted by the unit file).
# DHCP_BIND_TO_DEVICE=true
# DHCP_SERVER_PORT=67
# DHCP_CLIENT_PORT=68
# DHCP_BROADCAST_ADDRESS=255.255.255.255
# Set false on networks that have no captive portal.
# PORTAL_EXPECT_REDIRECT=true
# LOG_LEVEL=INFO
