# Copy to .env.local for local development. On Vercel, set these under
# Project -> Settings -> Environment Variables (never commit real values).

# Base URL of the Caddy front door on the campus server (no trailing path).
PROMETHEUS_URL=https://metrics.campus.example.edu
# Must equal PROMETHEUS_BEARER_TOKEN in docker/.env on the server.
PROMETHEUS_BEARER_TOKEN=

# Sign-in for the dashboard (shown as a login form on the front page). Required in production:
# without both values the dashboard refuses to show data. Not needed for local development.
DASHBOARD_USER=
DASHBOARD_PASSWORD=
# Optional: secret used to sign session cookies. If unset, a key derived from the user and
# password is used (changing the password then signs everyone out).
SESSION_SECRET=

# Optional: seconds to cache a Prometheus snapshot per serverless instance (default 5).
METRICS_CACHE_SECONDS=5

# Optional: link to Grafana shown in the header (public URL or VPN-only URL for staff).
NEXT_PUBLIC_GRAFANA_URL=

# Local development against an http:// Prometheus only. Ignored for localhost URLs.
ALLOW_INSECURE_PROMETHEUS=false

# Set to true to show built-in SAMPLE data without any backend (previews / demos only).
# While enabled, PROMETHEUS_URL and PROMETHEUS_BEARER_TOKEN are ignored.
DEMO_MODE=false
